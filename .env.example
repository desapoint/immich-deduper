# public port
DEDUP_DATA=./data
DEDUP_PORT=8086

# qdrant ports
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333

# immich
IMMICH_PATH=/path/to/your/immich/photos

# Optional API-first stacking. Direct PostgreSQL stacking is used when these
# are absent or the API request is unavailable.
# IMMICH_URL=https://immich.example.com
# IMMICH_API_KEY=your_single_user_api_key
# For multiple users, map owner UUIDs to keys as JSON (takes priority):
# IMMICH_API_KEYS={"owner-uuid":"api-key"}

# Optional: separate thumbnail path (if using Immich's THUMB_LOCATION)
# IMMICH_THUMB=/path/to/your/immich/thumbnails

# immich db
PSQL_HOST=localhost
PSQL_PORT=5432
PSQL_DB=immich
PSQL_USER=your_username
PSQL_PASS=your_password_here


#====================================
# Optional Settings
#====================================

# Force CPU mode (disable GPU acceleration)
#ForceCpu=True

# Offline mode for air-gapped environments (skips version check and Immich logic verification)
#OFFLINE=True

#====================================
# Development Only
#====================================
IsDev=False
